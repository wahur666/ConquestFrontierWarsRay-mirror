{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "src/Framework/Framework.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      },
      "includePrivateMembers": true,
      "disableGitFeatures": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "framework.md",
          "plan.md",
          "framework-pain-points.md",
          "ui-event-consumption-proposal.md",
          "basic-layout-containers-proposal.md",
          "toc.yml",
          "api/**.yml"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "ConquestFrontierWarsRay",
      "_appTitle": "ConquestFrontierWarsRay framework docs",
      "_enableSearch": true,
      "_disableContribution": true
    },
    "disableGitFeatures": true
  }
}
