{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "src/**/*.csproj"
          ],
          "exclude": [
            "src/Framework.TestApp/**",
            "src/Conquest/**",
            "src/Legacy.RaySharp/**",
            "src/MiniLayout.Demo/**",
            "src/Runtime.MapGen.Tool/**"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      },
      "includePrivateMembers": true,
      "disableGitFeatures": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "*.md",
          "toc.yml",
          "api/**.yml"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "ConquestFrontierWarsRay",
      "_appTitle": "ConquestFrontierWarsRay framework docs",
      "_enableSearch": true,
      "_disableContribution": true
    },
    "disableGitFeatures": true
  }
}
